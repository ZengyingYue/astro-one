# Copy to production.env in the same machine configuration directory and fill in the values.
ASTRO_ONE_DESKTOP_APP_ID=com.astro.one
ASTRO_ONE_DESKTOP_AUTO_UPDATE_ENV=production
ASTRO_ONE_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
ASTRO_ONE_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# ASTRO_ONE_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
ASTRO_ONE_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
ASTRO_ONE_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
