{
  "name": "@astro-one/mcp-resources",
  "description": "Scoped MCP resource discovery and reading through shared model tools",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/mcp/mcp-resources"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tools": "workspace:*"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/ptc-runtime": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/agent": "workspace:*"
  },
  "dependencies": {
    "@astro-one/util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@astro-one/system-prompt": {
      "optional": true
    }
  }
}
