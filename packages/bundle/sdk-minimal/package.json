{
  "name": "@astro-one/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "astroOne": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@astro-one/cordis-plugin-timer": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-loop": "workspace:*",
    "@astro-one/deepseek-llm-api-extensions": "workspace:*",
    "@astro-one/invariants": "workspace:*",
    "@astro-one/jobs-local": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/llm-deepseek": "workspace:*",
    "@astro-one/llm-retry": "workspace:*",
    "@astro-one/mcp-resources": "workspace:*",
    "@astro-one/plugin-package-inventory-deepseek": "workspace:*",
    "@astro-one/sandbox-local": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/sdk-app": "workspace:*",
    "@astro-one/sdk-jsonrpc-server": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-log-deepseek": "workspace:*",
    "@astro-one/session-persistence-jsonl": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/session-title": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/terminal": "workspace:*",
    "@astro-one/terminal-bash": "workspace:*",
    "@astro-one/tool-bash-persistent": "workspace:*",
    "@astro-one/tool-pwsh-persistent": "workspace:*",
    "@astro-one/tools": "workspace:*"
  },
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~"
  }
}
