{
  "name": "@astro-one/headless",
  "description": "The astro-one one-shot bundle: a direct core Agent/Session runner over astro-one-base with no Host, HTTP, or browser layer",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "astroOne": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@astro-one/brand": "workspace:*",
    "@astro-one/cmdline": "workspace:*",
    "@astro-one/util-values": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-default-model": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-query": "workspace:*",
    "@astro-one/fs": "workspace:*"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-default-model": "workspace:*",
    "@astro-one/agent-loop": "workspace:*",
    "@astro-one/agent-loop-testkit": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-query": "workspace:*",
    "@astro-one/fs": "workspace:*"
  }
}
