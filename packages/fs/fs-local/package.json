{
  "name": "@astro-one/fs-local",
  "description": "Local-filesystem implementation of the Astro One filesystem seam (ctx.fs)",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/fs": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "koffi": "^3.1.0",
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/fs": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  }
}
