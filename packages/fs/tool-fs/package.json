    "@astro-one/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@astro-one/attachment": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/user-approval": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-loop": "workspace:*",
    "@astro-one/agent-loop-testkit": "workspace:*",
    "@astro-one/attachment": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/fs-local": "workspace:*",
    "@astro-one/fs-observation-policy": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/llm-deepseek": "workspace:*",
    "@astro-one/llm-deepseek-api-key": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tool-executor-native": "workspace:*",
    "@astro-one/tool-executor-ptc": "workspace:*",
    "@astro-one/tool-testkit": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/user-approval": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/ptc-runtime": "workspace:*",
    "@astro-one/fs-sandbox": "workspace:*",
    "@astro-one/working-directory": "workspace:*"
  }
