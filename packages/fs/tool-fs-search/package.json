{
  "name": "@astro-one/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@astro-one/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@astro-one/llm": "workspace:*",
    "@astro-one/output-retention": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/spill": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/output-retention": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/spill": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/scope": "workspace:*"
  }
}
