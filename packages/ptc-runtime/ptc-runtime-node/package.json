{
  "name": "@astro-one/ptc-runtime-node",
  "description": "Sandboxed Node process implementation of the Astro One PTC execution capability",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/ptc-runtime": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@astro-one/util-values": "workspace:*",
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/ptc-runtime": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/fs-local": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/sandbox-local": "workspace:*"
  }
}
