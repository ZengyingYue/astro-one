{
  "name": "@astro-one/schedule",
  "description": "Host-wide durable reminders with shared management and delivery to existing or new Sessions",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/api-session-controller": "workspace:*",
    "@astro-one/brand": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-persistence": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/storage-domain": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/typert-protocol": "workspace:*",
    "@astro-one/util-time": "workspace:*",
    "@astro-one/workspace": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-loop": "workspace:*",
    "@astro-one/agent-loop-testkit": "workspace:*",
    "@astro-one/api-session-controller": "workspace:*",
    "@astro-one/brand": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-persistence": "workspace:*",
    "@astro-one/session-persistence-jsonl": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/session-title": "workspace:*",
    "@astro-one/storage": "workspace:*",
    "@astro-one/storage-domain": "workspace:*",
    "@astro-one/storage-json": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tool-executor-native": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/typert-protocol": "workspace:*",
    "@astro-one/util-time": "workspace:*",
    "@astro-one/workspace": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/goal": "workspace:*",
    "@astro-one/goal-round-driver": "workspace:*"
  }
}
