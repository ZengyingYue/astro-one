{
  "name": "@astro-one/terminal-bash",
  "description": "Persistent shell PTY backend over the Astro One subprocess terminal primitive",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/terminal": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/session-projection": "workspace:*"
  },
  "dependencies": {
    "@astro-one/lazy-require": "workspace:*",
    "@astro-one/pwsh-local": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-loop-testkit": "workspace:*",
    "@astro-one/terminal": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  }
}
