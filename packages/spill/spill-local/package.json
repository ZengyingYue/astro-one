{
  "name": "@astro-one/spill-local",
  "description": "Local-filesystem implementation of the Astro One spill storage seam (private session-scoped files)",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/spill/spill-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/spill": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/brand": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/spill": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  }
}
