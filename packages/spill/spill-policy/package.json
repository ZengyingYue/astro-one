{
  "name": "@astro-one/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/llm": "workspace:*",
    "@astro-one/output-retention": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/spill": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/attachment": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/token-meter": "workspace:*"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/ptc-runtime-node": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/output-retention": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/spill": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/fs-local": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/sandbox-local": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/attachment": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/token-meter": "workspace:*",
    "@astro-one/mcp-client": "workspace:*",
    "@astro-one/spill-local": "workspace:*",
    "@astro-one/llm-deepseek": "workspace:*",
    "@astro-one/ptc-runtime": "workspace:*",
    "@astro-one/attachment-local": "workspace:*",
    "@astro-one/tool-fs": "workspace:*",
    "sharp": "^0.35.3"
  }
}
