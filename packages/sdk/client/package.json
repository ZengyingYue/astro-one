{
  "name": "@astro-one/sdk-client",
  "description": "TypeScript client SDK for driving a Astro One runtime subprocess over stdio JSON-RPC: the AstroOne high-level turns API and the lower-level HarnessClient",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@astro-one/cli": "workspace:*"
  },
  "peerDependencies": {
    "@astro-one/llm": "workspace:*",
    "@astro-one/sdk-protocol": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/llm": "workspace:*",
    "@astro-one/sdk-protocol": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  }
}
