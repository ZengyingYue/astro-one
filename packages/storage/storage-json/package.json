{
  "name": "@astro-one/storage-json",
  "description": "JSON file KV storage backend for the Astro One storage hub",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/storage/storage-json"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/storage": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/storage": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  }
}
