{
  "name": "@astro-one/bash-sandbox",
  "description": "Sandbox-consuming implementation of the Astro One bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/shell": "workspace:*",
    "@astro-one/bash-local": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/shell": "workspace:*",
    "@astro-one/bash-local": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-local": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/node-addon-system": "workspace:~",
    "@astro-one/session-projection": "workspace:*"
  }
}
