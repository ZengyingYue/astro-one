{
  "name": "@astro-one/shell-env",
  "description": "Tool-independent managed ASTRO_ONE_* shell environment registry",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/shell/shell-env"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/home-paths": "workspace:*",
    "@astro-one/shell": "workspace:*",
    "@astro-one/tools": "workspace:*"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/home-paths": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/shell": "workspace:*",
    "@astro-one/tools": "workspace:*"
  }
}
