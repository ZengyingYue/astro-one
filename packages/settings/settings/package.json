{
  "name": "@astro-one/settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Astro One",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/brand": "workspace:*",
    "@astro-one/invariants": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/brand": "workspace:*",
    "@astro-one/invariants": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "@astro-one/cordis-plugin-timer": "workspace:~",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/hmr": "workspace:*",
    "@astro-one/agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@astro-one/util-values": "workspace:*",
    "@astro-one/config-editor": "workspace:*",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
