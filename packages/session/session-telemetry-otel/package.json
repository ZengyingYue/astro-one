{
  "name": "@astro-one/session-telemetry-otel",
  "description": "OpenTelemetry backend for the Astro One telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@astro-one/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@astro-one/command-feedback": "workspace:*",
    "@astro-one/message-feedback": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-telemetry": "workspace:*",
    "@astro-one/anonymous-user-id": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis-plugin-logger-console": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/bash-local": "workspace:*",
    "@astro-one/command-feedback": "workspace:*",
    "@astro-one/message-feedback": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/loader-smoke": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-checkpoint-policy": "workspace:*",
    "@astro-one/session-persistence-jsonl": "workspace:*",
    "@astro-one/session-telemetry": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/anonymous-user-id": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/http-proxy": "workspace:*"
  }
}
