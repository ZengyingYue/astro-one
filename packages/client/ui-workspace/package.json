{
  "name": "@astro-one/client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "astroOne": {
    "client": {
      "inject": [
        "@astro-one/api-remotes",
        "@astro-one/api-session-controller",
        "@astro-one/api-workspace-controller",
        "@astro-one/client-connection",
        "@astro-one/client-locale",
        "@astro-one/client-ui-conversation",
        "@astro-one/client-ui-layout",
        "@astro-one/client-ui-renderer",
        "@astro-one/client-ui-session",
        "@astro-one/client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/api-remotes": "workspace:*",
    "@astro-one/agent": "workspace:*",
    "@astro-one/api-session-controller": "workspace:*",
    "@astro-one/api-workspace-controller": "workspace:*",
    "@astro-one/client-connection": "workspace:*",
    "@astro-one/client-locale": "workspace:*",
    "@astro-one/client-store": "workspace:*",
    "@astro-one/client-test-runtime": "workspace:*",
    "@astro-one/client-ui-conversation": "workspace:*",
    "@astro-one/client-ui-layout": "workspace:*",
    "@astro-one/client-ui-primitives": "workspace:*",
    "@astro-one/client-ui-renderer": "workspace:*",
    "@astro-one/client-ui-session": "workspace:*",
    "@astro-one/client-ui-sidebar": "workspace:*",
    "@astro-one/client-ui-slots": "workspace:*",
    "@astro-one/jobs": "workspace:*",
    "@astro-one/schedule": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/typert-protocol": "workspace:*",
    "@astro-one/util-values": "workspace:*",
    "@astro-one/util-workspace-path": "workspace:*",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
