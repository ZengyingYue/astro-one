{
  "name": "@astro-one/client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "astroOne": {
    "client": {
      "inject": [
        "@astro-one/api-remotes",
        "@astro-one/client-connection",
        "@astro-one/client-locale",
        "@astro-one/client-ui-chat",
        "@astro-one/client-ui-conversation",
        "@astro-one/client-ui-renderer",
        "@astro-one/client-ui-sidebar-right",
        "@astro-one/client-ui-tool",
        "@astro-one/client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/api-remotes": "workspace:*",
    "@astro-one/client-connection": "workspace:*",
    "@astro-one/client-locale": "workspace:*",
    "@astro-one/client-store": "workspace:*",
    "@astro-one/client-test-runtime": "workspace:*",
    "@astro-one/client-ui-chat": "workspace:*",
    "@astro-one/client-ui-conversation": "workspace:*",
    "@astro-one/client-ui-dockkit": "workspace:*",
    "@astro-one/client-ui-renderer": "workspace:*",
    "@astro-one/client-ui-sidebar-right": "workspace:*",
    "@astro-one/client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "@astro-one/cordis": "workspace:~",
    "react": "^18.2.0",
    "@astro-one/client-ui-primitives": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/session-query": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/client-ui-tool": "workspace:*",
    "@astro-one/tool-present": "workspace:*",
    "@astro-one/workspace-changes": "workspace:*",
    "@astro-one/api-session-controller": "workspace:*",
    "@astro-one/util-workspace-path": "workspace:*",
    "@astro-one/api-workspace-files": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/fs-local": "workspace:*",
    "@astro-one/agent": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/client-ui-settings": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@astro-one/typert-protocol": "workspace:*"
  }
}
