{
  "name": "@astro-one/client-modules",
  "description": "Client module system, dual-face: node half composes the __ASTRO_ONE_BOOT__ entry graph (incremental astroOne.client scan, bundle route, index tap, webPlugins service); browser half is the lazy-CJS module table the vendored cordis Loader consumes as its internal seam",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/client/modules"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "astroOne": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/host-webserver": "workspace:*",
    "@astro-one/invariants": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/package-manifest": "workspace:*",
    "@astro-one/client-store": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~"
  }
}
