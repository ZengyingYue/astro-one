{
  "name": "@astro-one/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "astroOne": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/timeout": "workspace:*"
  },
  "dependencies": {
    "@astro-one/brand": "workspace:*",
    "@astro-one/sdk-protocol": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "@openai/codex": "0.153.4"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/loader-smoke": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-checkpoint-policy": "workspace:*",
    "@astro-one/session-persistence-jsonl": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/tool-jobs": "workspace:*",
    "@astro-one/tool-subagent": "workspace:*",
    "@astro-one/tools": "workspace:*"
  }
}
