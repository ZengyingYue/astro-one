{
  "name": "@astro-one/subagent-astro-one-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Astro One runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/subagent/subagent-astro-one-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/sdk-client": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/subprocess": "workspace:*"
  },
  "dependencies": {
    "@astro-one/brand": "workspace:*",
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-instructions": "workspace:*",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/llm-deepseek": "workspace:*",
    "@astro-one/loader-smoke": "workspace:*",
    "@astro-one/sdk-client": "workspace:*",
    "@astro-one/sdk-protocol": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-checkpoint-policy": "workspace:*",
    "@astro-one/session-persistence-jsonl": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/skill-filesystem": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tool-subagent": "workspace:*"
  }
}
