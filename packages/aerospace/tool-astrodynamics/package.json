{
  "name": "@astro-one/tool-astrodynamics",
  "description": "Model-facing astrodynamics tools for Astro One: orbit propagation, orbit determination, transfers, ground-station passes, conjunction assessment, frame conversion, and attitude determination",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/aerospace/tool-astrodynamics"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@astro-one/astrodynamics": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "@astro-one/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/tools": "workspace:*"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tools": "workspace:*"
  }
}
