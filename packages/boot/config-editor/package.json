{
  "name": "@astro-one/config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/boot/config-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/hmr": "workspace:*",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@astro-one/app-boot": "workspace:*"
  },
  "dependencies": {
    "@astro-one/atomic-write": "workspace:*",
    "yaml": "^2.8.1",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/hmr": "workspace:*",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "@astro-one/app-boot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@astro-one/hmr": {
      "optional": true
    }
  }
}
