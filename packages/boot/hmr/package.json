{
  "name": "@astro-one/hmr",
  "description": "Coordinated module and profile configuration hot reload",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/boot/hmr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis-plugin-timer": "workspace:~",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/cmdline": "workspace:*"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "^4.0.3",
    "picomatch": "^4.0.3",
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/picomatch": "^3.0.2",
    "esbuild": "^0.28.1",
    "@astro-one/cordis-plugin-timer": "workspace:~",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/cmdline": "workspace:*",
    "@astro-one/atomic-write": "workspace:*"
  }
}
