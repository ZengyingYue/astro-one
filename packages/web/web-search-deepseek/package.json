{
  "name": "@astro-one/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the Astro One web capability seam (ctx.web)",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/credentials": "workspace:*",
    "@astro-one/launch-environment": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/web": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/agent": "workspace:*",
    "@astro-one/credentials": "workspace:*",
    "@astro-one/credentials-local": "workspace:*",
    "@astro-one/launch-environment": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/web": "workspace:*",
    "@astro-one/cordis": "workspace:~",
    "@astro-one/http-proxy": "workspace:*"
  }
}
