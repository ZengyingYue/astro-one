{
  "name": "@astro-one/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Astro One web capability seam (ctx.web)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/web": "workspace:*"
  },
  "dependencies": {
    "@astro-one/output-retention": "workspace:*",
    "@astro-one/util-values": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/spill-local": "workspace:*",
    "@astro-one/spill-policy": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tool-call-timeout-policy": "workspace:*",
    "@astro-one/tool-executor-native": "workspace:*",
    "@astro-one/tool-testkit": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/web": "workspace:*",
    "@astro-one/web-deepseek-api": "workspace:*",
    "@astro-one/web-fetch-http": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@astro-one/scope": "workspace:*",
    "@astro-one/token-meter": "workspace:*",
    "@astro-one/launch-environment": "workspace:*"
  }
}
