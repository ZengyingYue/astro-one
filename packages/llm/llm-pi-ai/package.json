{
  "name": "@astro-one/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Astro One LLM seam (design-verification twin of astro-one-llm-deepseek)",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/attachment": "workspace:*",
    "@astro-one/authorization": "workspace:*",
    "@astro-one/credentials": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/launch-environment": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@astro-one/brand": "workspace:*",
    "@astro-one/util-values": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/attachment": "workspace:*",
    "@astro-one/authorization": "workspace:*",
    "@astro-one/credentials": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/launch-environment": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/llm-deepseek": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/http-proxy": "workspace:*",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/settings": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@astro-one/cordis-plugin-loader": {
      "optional": true
    }
  }
