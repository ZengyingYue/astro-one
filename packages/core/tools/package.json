{
  "name": "@astro-one/tools",
  "description": "Tool registry and execution pipeline for the Astro One",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./pipeline": {
      "types": "./lib/types/pipeline.d.ts",
      "default": "./lib/pipeline.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/pipeline.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/user-approval": "workspace:*"
  },
  "dependencies": {
    "@astro-one/brand": "workspace:*",
    "@astro-one/util-values": "workspace:*",
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tool-executor-native": "workspace:*",
    "@astro-one/tool-testkit": "workspace:*",
    "@astro-one/user-approval": "workspace:*",
    "@astro-one/agent-loop-testkit": "workspace:*"
  }
}
