{
  "name": "@astro-one/subprocess-local",
  "description": "Local-subprocess implementation of the Astro One subprocess seam",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./lib/types/output.d.ts",
      "default": "./lib/output.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/runner.js",
    "lib/runner-*.js",
    "lib/output.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  },
  "dependencies": {
    "@astro-one/lazy-require": "workspace:*",
    "@astro-one/win32-process": "workspace:*",
    "koffi": "3.1.1",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@astro-one/loader-smoke": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/cordis": "workspace:~"
  }
}
