{
  "name": "@astro-one/api-job-controller",
  "description": "Job Remote observation stream and the reference-counted client job-output service",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/api/job-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "astroOne": {
    "client": {
      "external": [
        "@astro-one/api-gateway/client"
      ],
      "inject": [
        "@astro-one/api-gateway",
        "@astro-one/client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@astro-one/typert-protocol": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/api-gateway": "workspace:*",
    "@astro-one/client-connection": "workspace:*",
    "@astro-one/client-store": "workspace:*",
    "@astro-one/jobs": "workspace:*",
    "@astro-one/jobs-local": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/typert-registry": "workspace:*"
  }
}
