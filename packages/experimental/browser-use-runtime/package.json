{
  "name": "@astro-one/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/browser-use": "workspace:*",
    "@astro-one/mcp-client": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/browser-use": "workspace:*",
    "@astro-one/mcp-client": "workspace:*",
    "@astro-one/scope": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/agent-loop-testkit": "workspace:*",
    "@astro-one/agent-loop": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/mcp-resources": "workspace:*",
    "@astro-one/ptc-runtime": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@astro-one/attachment-local": "workspace:*",
    "@astro-one/session-persistence-jsonl": "workspace:*"
  }
}
