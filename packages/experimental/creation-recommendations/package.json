{
  "name": "@astro-one/creation-recommendations",
  "description": "Create persistent removable interface plugins from explicit conversation needs",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/experimental/creation-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./references/*.md": "./references/*.md",
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/skill": "workspace:*"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/llm": "workspace:*",
    "@astro-one/tools": "workspace:*",
    "@astro-one/agent": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/plugin-manager": "workspace:*",
    "@astro-one/api-remote-access": "workspace:*",
    "@astro-one/subagent": "workspace:*",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/skill": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/tool-testkit": "workspace:*"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "resolve.exports": "^2.0.3",
    "zod": "4.4.3",
    "@astro-one/client-ui-creation-recommendations": "workspace:*",
    "@astro-one/action-cards": "workspace:*",
    "@astro-one/client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "references/*.md",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "icon": "./icon.svg"
}
