{
  "name": "@astro-one/experimental-inspector",
  "description": "Experimental cross-realm CDP hub for Host debugging and Client Runtime inspection",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/experimental/inspector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "astroOne": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/brand": "workspace:*",
    "@astro-one/util-crypto": "workspace:*",
    "@astro-one/schemastery": "workspace:~",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/client-modules": "workspace:*",
    "@astro-one/host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "@astro-one/cordis-plugin-loader": "workspace:~",
    "@astro-one/host-webserver": "workspace:*",
    "@types/ws": "^8.18.1",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2"
  }
}
