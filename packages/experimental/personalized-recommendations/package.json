{
  "name": "@astro-one/personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.2-alpha.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@astro-one/action-cards": "workspace:*",
    "@astro-one/client-ui-action-cards": "workspace:*",
    "@astro-one/creation-recommendations": "workspace:*",
    "@astro-one/client-ui-creation-recommendations": "workspace:*",
    "@astro-one/plugin-recommendations": "workspace:*",
    "@astro-one/client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@astro-one/cordis-plugin-timer": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/api-remote-access": "workspace:*",
    "@astro-one/app-boot": "workspace:*",
    "@astro-one/hmr": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/plugin-manager": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/skill": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/tool-executor-native": "workspace:*",
    "@astro-one/tools": "workspace:*"
  },
  "astroOne": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
