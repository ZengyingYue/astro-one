{
  "name": "@astro-one/experimental-client-ui-forge",
  "description": "Sidebar panel for a Session's change requests, with a worktree option for new Sessions and its Host Remote",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengyingYue/astro-one.git",
    "directory": "packages/experimental/client-ui-forge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "astroOne": {
    "client": {
      "inject": [
        "@astro-one/api-remotes",
        "@astro-one/client-locale",
        "@astro-one/client-ui-conversation",
        "@astro-one/client-ui-layout",
        "@astro-one/client-ui-sidebar-right",
        "@astro-one/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/experimental-worktree": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/experimental-forge": "workspace:*",
    "@astro-one/fs": "workspace:*"
  },
  "dependencies": {
    "@astro-one/schemastery": "workspace:~",
    "@astro-one/util-values": "workspace:*",
    "diff": "^9.0.0",
    "zod": "^4.4.3",
    "@astro-one/typert-protocol": "workspace:*",
    "@astro-one/storage-domain": "workspace:*"
  },
  "devDependencies": {
    "@astro-one/cordis": "workspace:~",
    "@astro-one/agent": "workspace:*",
    "@astro-one/agent-loop-testkit": "workspace:*",
    "@astro-one/api-remotes": "workspace:*",
    "@astro-one/api-session-controller": "workspace:*",
    "@astro-one/client-locale": "workspace:*",
    "@astro-one/client-store": "workspace:*",
    "@astro-one/client-test-runtime": "workspace:*",
    "@astro-one/client-ui-conversation": "workspace:*",
    "@astro-one/client-ui-layout": "workspace:*",
    "@astro-one/client-ui-primitives": "workspace:*",
    "@astro-one/client-ui-renderer": "workspace:*",
    "@astro-one/client-ui-session": "workspace:*",
    "@astro-one/client-ui-sidebar-right": "workspace:*",
    "@astro-one/client-ui-slots": "workspace:*",
    "@astro-one/client-ui-workspace": "workspace:*",
    "@astro-one/experimental-forge": "workspace:*",
    "@astro-one/experimental-forge-session": "workspace:*",
    "@astro-one/experimental-worktree": "workspace:*",
    "@astro-one/fs": "workspace:*",
    "@astro-one/fs-local": "workspace:*",
    "@astro-one/llm": "workspace:*",
    "@astro-one/sandbox": "workspace:*",
    "@astro-one/sandbox-local": "workspace:*",
    "@astro-one/sandbox-policy": "workspace:*",
    "@astro-one/session": "workspace:*",
    "@astro-one/session-projection": "workspace:*",
    "@astro-one/subprocess": "workspace:*",
    "@astro-one/subprocess-local": "workspace:*",
    "@astro-one/system-prompt": "workspace:*",
    "@astro-one/util-workspace-path": "workspace:*",
    "@astro-one/working-directory": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@astro-one/timeout": "workspace:*",
    "@astro-one/session-projection-cache": "workspace:*",
    "@astro-one/session-query": "workspace:*",
    "@astro-one/api-remote-access": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
